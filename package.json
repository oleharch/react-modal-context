{
  "name": "react-modal-context",
  "version": "2.0.0",
  "description": "Modals by id for React: ModalProvider, a useModal hook and a Modal on the native <dialog>. TypeScript, zero dependencies, optional CSS with enter/exit animations, sheets and drawers.",
  "keywords": [
    "react",
    "modal",
    "dialog",
    "hooks",
    "context",
    "typescript",
    "accessibility",
    "drawer",
    "bottom-sheet"
  ],
  "license": "MIT",
  "author": "Oleh Molchanov (https://oleh-molchanov.vercel.app)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleharch/react-modal-context.git"
  },
  "homepage": "https://react-modal-context.vercel.app",
  "bugs": "https://github.com/oleharch/react-modal-context/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/lib/styles.css','dist/styles.css')\"",
    "build:demo": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
